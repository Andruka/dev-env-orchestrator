#!/usr/bin/env bash
# Dev Panel launcher.
#   dev-panel           запустить в фоне (если ещё не запущена) и открыть в браузере
#   dev-panel stop      остановить (вместе с запущенными из панели dup / npm start)
#   dev-panel restart   перезапустить
#   dev-panel status    запущена ли
#   dev-panel logs      лог панели
#   dev-panel fg        запустить в текущем терминале
#   dev-panel autostart on|off   запуск при входе в систему
set -euo pipefail

# При автозапуске из графической сессии ~/.local/bin (где node) может не быть в PATH
export PATH="$HOME/.local/bin:$PATH"

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dev-panel"
PIDFILE="$STATE/pid"
LOG="$STATE/panel.log"
PORT="$(node -e "console.log(require('$DIR/config.json').port || 7777)")"
URL="http://localhost:$PORT"
mkdir -p "$STATE"

running() { [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

start() {
  if running; then return; fi
  if curl -fs "$URL/api/config" >/dev/null 2>&1; then
    echo "Порт $PORT занят другим экземпляром панели (запущен не через dev-panel)." >&2
    return
  fi
  cd "$DIR"
  nohup node server.js >>"$LOG" 2>&1 &
  echo $! >"$PIDFILE"
  for _ in $(seq 1 50); do curl -fs "$URL/api/config" >/dev/null 2>&1 && break; sleep 0.1; done
  echo "Dev Panel запущена: $URL (лог: $LOG)"
}

stop() {
  if running; then
    kill "$(cat "$PIDFILE")"
    for _ in $(seq 1 100); do running || break; sleep 0.2; done
    echo "Dev Panel остановлена"
  else
    echo "Dev Panel не запущена"
  fi
  rm -f "$PIDFILE"
}

open_ui() { xdg-open "$URL" >/dev/null 2>&1 & }

case "${1:-open}" in
  open)    start; open_ui ;;
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  running && echo "запущена (pid $(cat "$PIDFILE")) — $URL" || echo "не запущена" ;;
  logs)    tail -n 200 -f "$LOG" ;;
  fg)      cd "$DIR" && exec node server.js ;;
  autostart)
    AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/dev-panel.desktop"
    case "${2:-}" in
      on)
        mkdir -p "$(dirname "$AUTOSTART")"
        cat >"$AUTOSTART" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Dev Panel
Comment=Запуск Dev Panel в фоне при входе в систему
Exec=$DIR/bin/dev-panel start
Terminal=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=5
DESKTOP
        echo "Автозапуск включён: $AUTOSTART" ;;
      off) rm -f "$AUTOSTART"; echo "Автозапуск выключен" ;;
      *) [[ -f "$AUTOSTART" ]] && echo "Автозапуск включён ($AUTOSTART)" || echo "Автозапуск выключен" ;;
    esac ;;
  *)       sed -n '2,9p' "$0"; exit 1 ;;
esac

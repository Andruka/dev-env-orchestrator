#!/usr/bin/env bash
# Dev Panel launcher.
#   dev-panel           запустить в фоне (если ещё не запущена) и открыть в отдельном окне
#   dev-panel web       то же, но открыть во вкладке обычного браузера
#   dev-panel stop      остановить (вместе с запущенными из панели dup / npm start)
#   dev-panel restart   перезапустить
#   dev-panel status    запущена ли
#   dev-panel logs      лог панели
#   dev-panel fg        запустить в текущем терминале
#   dev-panel autostart on|off   запуск при входе в систему
set -euo pipefail

# При автозапуске из графической сессии ~/.local/bin (где node) может не быть в PATH
export PATH="$HOME/.local/bin:$PATH"

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dev-panel"
PIDFILE="$STATE/pid"
LOG="$STATE/panel.log"
PORT="$(node -e "console.log(require('$DIR/config.json').port || 7777)")"
URL="http://localhost:$PORT"
mkdir -p "$STATE"

running() { [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

start() {
  if running; then return; fi
  if curl -fs "$URL/api/config" >/dev/null 2>&1; then
    echo "Порт $PORT занят другим экземпляром панели (запущен не через dev-panel)." >&2
    return
  fi
  cd "$DIR"
  # Свой systemd-scope: иначе панель живёт в cgroup терминала/tmux, из которого её запустили,
  # и systemd-oomd убивает её вместе с чужим прожорливым процессом. --scope делает exec, $! = pid node.
  local scope=()
  if systemd-run --user --scope --quiet --collect true >/dev/null 2>&1; then
    scope=(systemd-run --user --scope --quiet --collect --unit="dev-panel-$(date +%s)")
  fi
  nohup "${scope[@]}" node server.js >>"$LOG" 2>&1 &
  echo $! >"$PIDFILE"
  for _ in $(seq 1 50); do curl -fs "$URL/api/config" >/dev/null 2>&1 && break; sleep 0.1; done
  echo "Dev Panel запущена: $URL (лог: $LOG)"
}

stop() {
  if running; then
    kill "$(cat "$PIDFILE")"
    for _ in $(seq 1 100); do running || break; sleep 0.2; done
    echo "Dev Panel остановлена"
  else
    echo "Dev Panel не запущена"
  fi
  rm -f "$PIDFILE"
}

# Отдельное окно браузера в режиме приложения: без вкладок и адресной строки, свой профиль и свой
# WM_CLASS (своя иконка в панели задач). Повторный запуск активирует уже открытое окно.
APP_CLASS="DevPanel"
APP_PROFILE="${XDG_CONFIG_HOME:-$HOME/.config}/dev-panel/app-browser"

app_browser() {
  if [[ -n "${DEV_PANEL_BROWSER:-}" ]]; then echo "$DEV_PANEL_BROWSER"; return; fi
  for b in brave-browser google-chrome chromium chromium-browser; do
    command -v "$b" >/dev/null && { echo "$b"; return; }
  done
}

open_ui() {
  if command -v xdotool >/dev/null && xdotool search --class "$APP_CLASS" >/dev/null 2>&1; then
    xdotool search --class "$APP_CLASS" | tail -1 | xargs -r xdotool windowactivate >/dev/null 2>&1 && return
  fi
  local b; b="$(app_browser)"
  if [[ -z "$b" ]]; then xdg-open "$URL" >/dev/null 2>&1 & return; fi
  nohup "$b" --app="$URL" --class="$APP_CLASS" --user-data-dir="$APP_PROFILE" \
    --no-first-run --no-default-browser-check --window-size=1500,950 >/dev/null 2>&1 &
}

case "${1:-open}" in
  open)    start; open_ui ;;
  web)     start; xdg-open "$URL" >/dev/null 2>&1 & ;;
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  running && echo "запущена (pid $(cat "$PIDFILE")) — $URL" || echo "не запущена" ;;
  logs)    tail -n 200 -f "$LOG" ;;
  fg)      cd "$DIR" && exec node server.js ;;
  autostart)
    AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/dev-panel.desktop"
    case "${2:-}" in
      on)
        mkdir -p "$(dirname "$AUTOSTART")"
        cat >"$AUTOSTART" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Dev Panel
Comment=Запуск Dev Panel в фоне при входе в систему
Exec=$DIR/bin/dev-panel start
Terminal=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=5
DESKTOP
        echo "Автозапуск включён: $AUTOSTART" ;;
      off) rm -f "$AUTOSTART"; echo "Автозапуск выключен" ;;
      *) [[ -f "$AUTOSTART" ]] && echo "Автозапуск включён ($AUTOSTART)" || echo "Автозапуск выключен" ;;
    esac ;;
  *)       sed -n '2,10p' "$0"; exit 1 ;;
esac

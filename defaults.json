{
  "vars": {
    "calplanRoot": "",
    "dumpsDir": "{calplanRoot}/dbDumps",
    "dbDataDir": "{calplanRoot}/calplanDb",
    "composeFile": "docker-compose-without-qt.yml",
    "dbService": "calplanDb",
    "dbName": "calplanDb",
    "frontendUrl": "http://localhost:3000/objects/3140/plans",
    "frontendPort": 3000,
    "dbPort": 5432,
    "browserCmd": "",
    "browserProfile": "{home}/.config/brave-dev-cors",
    "debugPort": 9222,
    "authFollowsEnv": true,
    "migrationsDir": "src/AusPlan/Database/Migration",
    "snapshotsEnabled": true,
    "snapshotsDir": "{dataHome}/dev-panel/snapshots",
    "snapshotsKeepFresh": 8,
    "snapshotsKeepDump": 2,
    "dc": "docker compose -f {composeFile}",
    "swaggerDir": "{calplanRoot}/swagger",
    "swaggerUiPort": 9105,
    "swaggerEditorPort": 9104,
    "swaggerMockPort": 4010
  },
  "swaps": [
    {
      "id": "backendEnv",
      "group": "backend",
      "title": "Переменные бэкенда (.env)",
      "target": ".env",
      "patterns": [".env_*"],
      "kind": "env",
      "ideOverrides": {}
    },
    {
      "id": "frontendConfig",
      "group": "frontend",
      "title": "Конфиг фронтенда (public/config.js)",
      "target": "public/config.js",
      "patterns": ["public/config*.js"],
      "kind": "js"
    }
  ],
  "groups": [
    {
      "id": "backend",
      "title": "Бэкенд",
      "kind": "compose",
      "discover": {
        "root": "{calplanRoot}",
        "requireFile": "{composeFile}"
      },
      "paths": [],
      "exclude": [
        "server_old"
      ],
      "sections": [
        {
          "title": "Git",
          "actions": [
            "checkout",
            "pull",
            "stash",
            "stashPop"
          ]
        },
        {
          "title": "Окружение",
          "actions": [
            "deploy",
            "restoreDump",
            "up",
            "down",
            "dbRm",
            "openFolder"
          ]
        },
        {
          "title": "Снимки БД",
          "actions": [
            "snapSave"
          ]
        }
      ],
      "primary": "deploy"
    },
    {
      "id": "frontend",
      "title": "Фронтенд",
      "kind": "node",
      "paths": [
        "{calplanRoot}/CLIENT"
      ],
      "sections": [
        {
          "title": "Git",
          "actions": [
            "checkout",
            "pull",
            "stash",
            "stashPop"
          ]
        },
        {
          "title": "Запуск",
          "actions": [
            "frontDeploy",
            "quickStart",
            "npmCi",
            "npmCiForce",
            "npmStart",
            "npmStop",
            "browser",
            "auth",
            "openFolder"
          ]
        }
      ],
      "primary": "frontDeploy",
      "exclude": []
    },
    {
      "id": "swagger",
      "title": "Swagger",
      "kind": "generic",
      "paths": [
        "{swaggerDir}"
      ],
      "aliveVar": "swaggerUiPort",
      "sections": [
        {
          "title": "Git",
          "actions": [
            "checkout",
            "pull",
            "stash",
            "stashPop"
          ]
        },
        {
          "title": "Swagger",
          "actions": [
            "swaggerBuild",
            "swaggerStart",
            "swaggerOpen",
            "swaggerMockOpen",
            "swaggerEditor",
            "swaggerValidate",
            "swaggerStop",
            "openFolder"
          ]
        }
      ],
      "primary": "swaggerBuild",
      "exclude": []
    }
  ],
  "actions": {
    "checkout": {
      "title": "Сменить ветку",
      "icon": "git-branch",
      "params": [
        {
          "name": "branch",
          "title": "Ветка",
          "type": "gitBranch"
        }
      ],
      "steps": [
        {
          "title": "git fetch",
          "type": "shell",
          "cmd": "curl -sk -o /dev/null --max-time 3 http://localhost:{swaggerMockPort} || { echo 'Mock не отвечает на порту {swaggerMockPort} — запустите Swagger'; exit 1; }"
        },
        {
          "title": "git checkout {branch}",
          "type": "shell",
          "cmd": "git checkout \"$P_branch\""
        },
        {
          "title": "git pull --ff-only",
          "type": "shell",
          "cmd": "git pull --ff-only",
          "allowFail": true
        }
      ],
      "hint": "fetch → checkout → pull --ff-only. Незакоммиченные изменения не трогаются"
    },
    "down": {
      "title": "Остановить (ddown)",
      "hint": "Остановить контейнеры (все контейнеры docker; БД — штатно, остальное — за 2 с)",
      "icon": "square",
      "steps": [
        {
          "title": "Остановить процесс dup",
          "type": "stopService",
          "service": "compose"
        },
        {
          "title": "Остановить БД (штатно)",
          "type": "shell",
          "cmd": "docker ps -q --filter 'name=calplanDb' | xargs -r docker stop -t 60 >/dev/null; echo ok"
        },
        {
          "title": "docker compose down",
          "type": "shell",
          "cmd": "{dc} down -t 2"
        },
        {
          "title": "Остановить и удалить остальные контейнеры",
          "type": "shell",
          "cmd": "docker ps -aq | xargs -r docker stop -t 2 >/dev/null; docker ps -aq | xargs -r docker rm >/dev/null; echo ok"
        }
      ]
    },
    "dbRm": {
      "title": "Удалить БД (dbRm)",
      "hint": "Удалить данные БД (pgdata)",
      "icon": "trash-2",
      "confirm": "Удалить {dbDataDir}/pgdata?",
      "steps": [
        {
          "title": "Удалить pgdata",
          "type": "shell",
          "cmd": "docker run --rm -v '{dbDataDir}':/d alpine rm -rf /d/pgdata"
        }
      ],
      "danger": true
    },
    "up": {
      "title": "Поднять (dup)",
      "hint": "Поднять контейнеры и дождаться миграций (dup)",
      "icon": "play",
      "steps": [
        {
          "title": "docker compose up",
          "type": "service",
          "service": "compose",
          "cmd": "xhost local:root >/dev/null 2>&1 || true; exec docker compose -f {composeFile} up",
          "readyPattern": "calplanDbScript[^ ]* +exited with code 0",
          "failPattern": "(calplanDbScript|liquibase)[^ ]* +exited with code [1-9]"
        }
      ]
    },
    "deploy": {
      "title": "Развернуть с нуля",
      "hint": "ddown → dbRm → снимок (если есть) → dup → сохранить снимок",
      "icon": "rocket",
      "confirm": "Развернуть {project.name} с нуля? База будет удалена.",
      "steps": [
        {
          "type": "action",
          "action": "down"
        },
        {
          "type": "action",
          "action": "dbRm"
        },
        {
          "title": "Восстановить снимок миграций",
          "type": "snapshotRestore",
          "kind": "fresh",
          "dataDir": "{dbDataDir}",
          "migrationsDir": "{migrationsDir}"
        },
        {
          "type": "action",
          "action": "up"
        },
        {
          "title": "Сохранить снимок миграций",
          "type": "snapshotSave",
          "kind": "fresh",
          "dataDir": "{dbDataDir}",
          "migrationsDir": "{migrationsDir}",
          "keep": "{snapshotsKeepFresh}",
          "stopCmd": "{dc} stop -t 60 {dbService}",
          "startCmd": "{dc} ps -a --status exited -q {dbService} | grep -q . && {dc} start {dbService} || true"
        }
      ],
      "danger": true
    },
    "restoreDump": {
      "title": "Накатить дамп",
      "hint": "Снимок дампа, если есть; иначе импорт (снимок сохранится) → dup",
      "icon": "database-backup",
      "confirm": "База {dbName} будет пересоздана из {dump}. Продолжить?",
      "params": [
        {
          "name": "dump",
          "title": "Дамп",
          "type": "file",
          "dir": "{dumpsDir}",
          "ext": ".sql"
        }
      ],
      "steps": [
        {
          "type": "action",
          "action": "down"
        },
        {
          "title": "Восстановить снимок дампа",
          "type": "snapshotRestore",
          "kind": "dump",
          "dataDir": "{dbDataDir}",
          "dumpFile": "{dumpsDir}/{dump}"
        },
        {
          "title": "Поднять только БД",
          "type": "shell",
          "cmd": "{dc} up -d {dbService}",
          "unless": "restored"
        },
        {
          "title": "Ждать готовности БД",
          "type": "shell",
          "retry": {
            "times": 60,
            "delayMs": 2000
          },
          "cmd": "{dc} exec -T {dbService} sh -c 'pg_isready -U \"$POSTGRES_USER\" -d postgres'",
          "unless": "restored"
        },
        {
          "title": "Пересоздать базу {dbName}",
          "type": "shell",
          "unless": "restored",
          "cmd": "{dc} exec -T {dbService} sh -c 'psql -U \"$POSTGRES_USER\" -d postgres -v ON_ERROR_STOP=1 -c \"DROP DATABASE IF EXISTS \\\"{dbName}\\\" WITH (FORCE)\" -c \"CREATE DATABASE \\\"{dbName}\\\"\"'"
        },
        {
          "title": "Импорт {dump}",
          "type": "pipeFile",
          "file": "{dumpsDir}/{dump}",
          "unless": "restored",
          "cmd": "{dc} exec -T {dbService} sh -c 'psql -q -U \"$POSTGRES_USER\" -d \"{dbName}\"'"
        },
        {
          "title": "Сохранить снимок дампа",
          "type": "snapshotSave",
          "kind": "dump",
          "dataDir": "{dbDataDir}",
          "dumpFile": "{dumpsDir}/{dump}",
          "keep": "{snapshotsKeepDump}",
          "stopCmd": "{dc} stop -t 60 {dbService}",
          "unless": "restored"
        },
        {
          "type": "action",
          "action": "down",
          "unless": "restored"
        },
        {
          "type": "action",
          "action": "up"
        }
      ],
      "danger": true
    },
    "npmCi": {
      "title": "npm ci",
      "icon": "package",
      "hint": "Пропускается, если package-lock.json и версия node не менялись с прошлой установки",
      "steps": [
        {
          "title": "npm ci (если lock изменился)",
          "type": "shell",
          "cmd": "H=$(cat package-lock.json <(node -v) | sha256sum | cut -c1-64); if [ -d node_modules ] && [ \"$(cat node_modules/.dev-panel-lock 2>/dev/null)\" = \"$H\" ]; then echo 'package-lock.json не менялся — npm ci пропущен'; else npm ci && mkdir -p node_modules && echo \"$H\" > node_modules/.dev-panel-lock; fi"
        }
      ]
    },
    "npmStart": {
      "title": "npm start",
      "icon": "play",
      "steps": [
        {
          "title": "npm start",
          "type": "service",
          "service": "frontend",
          "cmd": "exec npm start",
          "env": {
            "BROWSER": "none",
            "FORCE_COLOR": "0"
          },
          "readyPattern": "Local:\\s+http"
        }
      ]
    },
    "npmStop": {
      "title": "Стоп",
      "icon": "square",
      "steps": [
        {
          "type": "stopService",
          "service": "frontend"
        }
      ]
    },
    "browser": {
      "title": "Браузер",
      "hint": "Браузер без CORS на странице фронтенда (с портом отладки для входа)",
      "icon": "globe",
      "steps": [
        {
          "type": "detached",
          "cmd": "{browserCmd} --user-data-dir='{browserProfile}' --disable-web-security --remote-debugging-port={debugPort} '{frontendUrl}'"
        }
      ]
    },
    "frontDeploy": {
      "title": "Собрать и запустить",
      "hint": "npm ci → npm start → браузер → вход",
      "icon": "rocket",
      "steps": [
        {
          "type": "action",
          "action": "npmStop"
        },
        {
          "type": "action",
          "action": "npmCi"
        },
        {
          "type": "action",
          "action": "npmStart"
        },
        {
          "type": "action",
          "action": "browser"
        },
        {
          "type": "action",
          "action": "auth"
        }
      ]
    },
    "pull": {
      "title": "Подтянуть",
      "icon": "arrow-down-to-line",
      "hint": "git fetch + git pull --ff-only (без merge-коммитов)",
      "steps": [
        {
          "title": "git fetch",
          "type": "shell",
          "cmd": "git fetch --all --prune"
        },
        {
          "title": "git pull --ff-only",
          "type": "shell",
          "cmd": "git pull --ff-only"
        }
      ]
    },
    "stash": {
      "title": "В stash",
      "icon": "archive",
      "hint": "Убрать все изменения (включая новые файлы) в stash",
      "params": [
        {
          "name": "message",
          "title": "Подпись stash (необязательно)",
          "type": "text",
          "optional": true
        }
      ],
      "steps": [
        {
          "title": "git stash push",
          "type": "shell",
          "cmd": "git stash push -u ${P_message:+-m \"$P_message\"}"
        }
      ]
    },
    "stashPop": {
      "title": "Из stash",
      "icon": "archive-restore",
      "hint": "Вернуть изменения из stash",
      "params": [
        {
          "name": "stash",
          "title": "Stash",
          "type": "stash"
        }
      ],
      "steps": [
        {
          "title": "git stash pop {stash}",
          "type": "shell",
          "cmd": "git stash pop \"$P_stash\""
        }
      ]
    },
    "auth": {
      "title": "Войти",
      "icon": "key-round",
      "hint": "Получить токен по API и записать его в браузер (логин в «Настройках»)",
      "steps": [
        {
          "title": "Авторизация в браузере",
          "type": "browserAuth",
          "url": "{frontendUrl}",
          "debugPort": "{debugPort}"
        }
      ]
    },
    "quickStart": {
      "title": "Запустить и войти",
      "icon": "zap",
      "hint": "npm start → браузер → вход (без npm ci)",
      "steps": [
        {
          "type": "action",
          "action": "npmStop"
        },
        {
          "type": "action",
          "action": "npmStart"
        },
        {
          "type": "action",
          "action": "browser"
        },
        {
          "type": "action",
          "action": "auth"
        }
      ]
    },
    "snapSave": {
      "title": "Сохранить текущую БД",
      "icon": "save",
      "hint": "Создаёт новый снимок (старые не трогает). БД остановится на несколько секунд",
      "params": [
        {
          "name": "name",
          "title": "Название снимка",
          "type": "text",
          "optional": true
        }
      ],
      "steps": [
        {
          "title": "Сохранить снимок",
          "type": "snapshotSave",
          "kind": "manual",
          "name": "{name}",
          "dataDir": "{dbDataDir}",
          "stopCmd": "{dc} stop -t 60 {dbService}",
          "startCmd": "{dc} ps -a --status exited -q {dbService} | grep -q . && {dc} start {dbService} || true"
        }
      ]
    },
    "snapRestore": {
      "title": "Восстановить БД",
      "icon": "history",
      "danger": true,
      "hint": "Заменить базу снимком → dup (докатит миграции ветки)",
      "confirm": "Текущая база будет заменена снимком «{snapshot}», затем dup докатит миграции ветки. Несохранённое состояние базы пропадёт. Продолжить?",
      "params": [
        {
          "name": "snapshot",
          "title": "Снимок",
          "type": "snapshot"
        }
      ],
      "steps": [
        {
          "type": "action",
          "action": "down"
        },
        {
          "title": "Восстановить снимок",
          "type": "snapshotRestore",
          "kind": "manual",
          "id": "{snapshot}",
          "dataDir": "{dbDataDir}"
        },
        {
          "type": "action",
          "action": "up"
        }
      ],
      "internal": true
    },
    "snapDelete": {
      "title": "Удалить снимок",
      "icon": "x",
      "danger": true,
      "confirm": "Удалить снимок {snapshot}?",
      "params": [
        {
          "name": "snapshot",
          "title": "Снимок",
          "type": "snapshot"
        }
      ],
      "steps": [
        {
          "title": "Удалить снимок",
          "type": "snapshotDelete",
          "id": "{snapshot}"
        }
      ],
      "internal": true
    },
    "npmCiForce": {
      "title": "npm ci (заново)",
      "icon": "refresh-cw",
      "hint": "Всегда переустановить node_modules",
      "steps": [
        {
          "title": "npm ci",
          "type": "shell",
          "cmd": "npm ci && H=$(cat package-lock.json <(node -v) | sha256sum | cut -c1-64) && mkdir -p node_modules && echo \"$H\" > node_modules/.dev-panel-lock"
        }
      ]
    },
    "swaggerBuild": {
      "title": "Собрать и запустить",
      "icon": "hammer",
      "hint": "Проверить спецификацию, собрать bundle.json и поднять Swagger UI и mock (build.sh репозитория swagger)",
      "steps": [
        {
          "title": "build.sh",
          "type": "shell",
          "cmd": "bash ./build.sh"
        }
      ]
    },
    "swaggerStart": {
      "title": "Запустить (UI + mock)",
      "icon": "play",
      "hint": "Поднять Swagger UI и mock уже собранной спецификации (start.sh)",
      "steps": [
        {
          "title": "start.sh",
          "type": "shell",
          "cmd": "bash ./start.sh"
        }
      ]
    },
    "swaggerOpen": {
      "title": "Открыть Swagger UI",
      "icon": "globe",
      "hint": "Открыть локальный Swagger UI в браузере по умолчанию",
      "steps": [
        {
          "title": "Проверка",
          "type": "shell",
          "cmd": "curl -sk -o /dev/null --max-time 3 http://localhost:{swaggerUiPort} || { echo 'Swagger UI не отвечает на порту {swaggerUiPort} — нажмите «Собрать и запустить» или «Запустить»'; exit 1; }"
        },
        {
          "title": "xdg-open",
          "type": "detached",
          "cmd": "xdg-open http://localhost:{swaggerUiPort}"
        }
      ]
    },
    "swaggerMockOpen": {
      "title": "Открыть mock",
      "icon": "globe",
      "hint": "Открыть mock-сервер (prism) в браузере: порт {swaggerMockPort}",
      "steps": [
        {
          "title": "Проверка",
          "type": "shell",
          "cmd": "curl -sk -o /dev/null --max-time 3 http://localhost:{swaggerMockPort} || { echo 'Mock не отвечает на порту {swaggerMockPort} — запустите Swagger'; exit 1; }"
        },
        {
          "title": "xdg-open",
          "type": "detached",
          "cmd": "xdg-open http://localhost:{swaggerMockPort}"
        }
      ]
    },
    "swaggerEditor": {
      "title": "Редактор",
      "icon": "pencil",
      "hint": "Поднять Swagger Editor и открыть его в браузере",
      "steps": [
        {
          "title": "docker compose up editor",
          "type": "shell",
          "cmd": "sh ./createEnvIfNotExists.sh && docker compose -f docker-compose.yml up -d editor"
        },
        {
          "title": "xdg-open",
          "type": "detached",
          "cmd": "xdg-open http://localhost:{swaggerEditorPort}"
        }
      ]
    },
    "swaggerValidate": {
      "title": "Проверить спецификацию",
      "icon": "shield-check",
      "hint": "Проверить api/main.yaml без сборки",
      "steps": [
        {
          "title": "validate",
          "type": "shell",
          "cmd": "sh ./createEnvIfNotExists.sh && docker compose -f docker-compose.yml run -T --rm cli validate api/main.yaml"
        }
      ]
    },
    "swaggerStop": {
      "title": "Остановить",
      "icon": "square",
      "hint": "Остановить контейнеры Swagger (UI, mock, редактор)",
      "steps": [
        {
          "title": "docker compose down",
          "type": "shell",
          "cmd": "docker compose -f docker-compose.yml down"
        }
      ]
    },
    "openFolder": {
      "title": "Открыть папку",
      "icon": "folder-open",
      "hint": "Открыть папку проекта в файловом менеджере",
      "steps": [
        {
          "title": "xdg-open",
          "type": "detached",
          "cmd": "xdg-open \"{project.path}\""
        }
      ]
    }
  },
  "port": 7777
}
